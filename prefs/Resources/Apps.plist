<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>Legacy name selections</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Choose which names to hide</string>
			<key>footerText</key>
			<string>Switch on a name to hide it. Names come from icon-bearing Battery rows you have viewed. Verify them against the Battery list; these are display names, not app identifiers.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Add app name…</string>
			<key>action</key>
			<string>addAppName</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Show all apps</string>
			<key>action</key>
			<string>showAllApps</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Names from Battery usage</string>
			<key>footerText</key>
			<string>If no names appear, visit Battery and scroll its list, or use Add app name. Matching is exact and case-sensitive. Two apps with the same display name cannot be distinguished.</string>
		</dict>
	</array>
</dict>
</plist>
